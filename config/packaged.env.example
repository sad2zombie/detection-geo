# 复制为 packaged.env 后按环境填写，再执行 npm run build 打包
# packaged.env 不入 Git（见 .gitignore），会打入安装包，首次启动释放到 %APPDATA%/detection/.env

# 拉取任务接口
CONSUMPTION_FETCH_URL=http://your-api/fetch-task

# Kafka 结果回传（明文）
KAFKA_BOOTSTRAP_SERVERS=120.24.174.129:9094
KAFKA_RESULT_TOPIC=your-result-topic

# 消费轮询
CONSUMPTION_POLL_ENABLED=true
CONSUMPTION_POLL_INTERVAL=10

# LLM（官网检测兜底，按需填写真实密钥）
LLM_API_KEY=
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=deepseek-v4-flash

# 可选：搜索引擎
# BING_API_KEY=
# BOCHA_API_KEY=
